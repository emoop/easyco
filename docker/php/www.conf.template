; EasyCo (DOCKER-1): php-fpm pool. Filled by docker/entrypoint.sh with envsubst; every variable has a default there (sized for a 4 GB server).
[www]
user = www-data
group = www-data
listen = 9000

pm = dynamic
pm.max_children = ${PHP_FPM_MAX_CHILDREN}
pm.start_servers = ${PHP_FPM_START_SERVERS}
pm.min_spare_servers = ${PHP_FPM_MIN_SPARE_SERVERS}
pm.max_spare_servers = ${PHP_FPM_MAX_SPARE_SERVERS}
pm.max_requests = 500
ping.path = /ping
ping.response = pong

clear_env = no
catch_workers_output = yes
decorate_workers_output = no

php_admin_value[upload_max_filesize] = ${PHP_UPLOAD_MAX_FILESIZE}
php_admin_value[post_max_size] = ${PHP_POST_MAX_SIZE}
