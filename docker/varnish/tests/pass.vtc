varnishtest "P8c-1: the pass classes (private paths, previews, search, filters, non-GET): every request reaches the backend, nothing is ever a HIT, even when the backend wrongly says s-maxage"

server s1 {
    rxreq
    txresp -hdr "Cache-Control: public, max-age=0, s-maxage=100" -hdr "xkey: all" -body "x"
} -repeat 52 -start

varnish v1 -vcl+backend {
    # the backend the rules ask `std.healthy()` about (production: default.vcl, with the probe). No probe here: a test sets its health by hand (backend.set_health health sick|auto).
    backend health {
        .host = "${s1_addr}";
        .port = "${s1_port}";
    }

    include "${vcldir}/rules.vcl";
} -start

client c1 {
    txreq -url "/admin"
    rxresp
    expect resp.status == 200
    expect resp.http.X-Cache == "MISS"
    txreq -url "/admin"
    rxresp
    expect resp.status == 200
    expect resp.http.X-Cache == "MISS"
