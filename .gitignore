# EasyCo sub-packages (packages/EasyCo/*) are Composer libraries — by
# convention a library doesn't commit its own vendor/ or composer.lock;
# only the root app's composer.lock (which resolves these via a path
# repository) is authoritative for a reproducible install.
/packages/EasyCo/*/vendor
/packages/EasyCo/*/composer.lock

# Looks like a backup/snapshot artifact (a zip of the whole packages/EasyCo/
# tree), not a source file — see the setup notes for this repo.
/packages/EasyCo.zip

# Local-only scratch notes/ideas — never tracked, never pushed. Anything
# placed here is explicitly not meant to leave this machine.
/notes/local/
