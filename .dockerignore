# DOCKER-1: keep the build context small and free of secrets / local state.
.git
.github
.idea
.vscode
.claude
.codex
.cursor
.nova
.zed

node_modules
vendor
packages/EasyCo/*/vendor
packages/EasyCo/*/composer.lock

# Secrets: only the examples are allowed in.
.env
.env.*
!.env.example
!.env.docker.example

storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
storage/app/*
storage/pail
bootstrap/cache/*.php
public/hot
public/storage
public/build
public/css/filament
public/js/filament

tests
packages/EasyCo/*/tests
phpunit.xml
rt.sh
help-test-fix.patch
notes
**/*.diff
**/*.diff.txt
packages/EasyCo/documents/*.jpg
packages/EasyCo/documents/*.jpeg
packages/EasyCo/documents/*.png
Thumbs.db
.DS_Store
docker-compose*.yml
Dockerfile
