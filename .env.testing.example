# Copy this file to .env.testing (git-ignored, exactly like .env) before
# running `php artisan test`. Laravel loads .env.testing instead of .env
# whenever APP_ENV=testing, so this file is what keeps the test suite off
# whatever database .env points at.
#
# WHY A SEPARATE DATABASE, NOT THE ONE .env USES: the Feature suite runs
# `RefreshDatabase`, which drops and recreates every table once per test
# process. Pointed at a database someone also uses for real work, a single
# `php artisan test` would destroy it. The database below must exist before
# the first run (create it empty, like the one migration expects) — creating
# it is the one step `migrate` will not do.
#
# ONE DATABASE PER WORKTREE, not one shared test database: two worktrees can
# run their suites at the same time, and a shared schema would make each run
# drop the other's tables mid-test. Name it after the worktree, e.g.
# `easyco_testing` for the main checkout, `easyco_testing_sandbox` for the
# sandbox worktree.
#
# NOTE: a cached config (bootstrap/cache/config.php) makes Laravel skip .env
# files entirely and use whatever database the cache was built with — run
# `php artisan config:clear` first (`composer test` does it for you).

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=easyco_testing_yourworktree
DB_USERNAME=root
DB_PASSWORD=root
