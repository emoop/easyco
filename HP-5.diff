+.sf-car-h-480 { --sf-car-hd: 480px; }
+
+.sf-car-hp-80 { --sf-car-hm: 80px; }
+.sf-car-hp-100 { --sf-car-hm: 100px; }
+.sf-car-hp-120 { --sf-car-hm: 120px; }
+.sf-car-hp-160 { --sf-car-hm: 160px; }
+.sf-car-hp-200 { --sf-car-hm: 200px; }
+.sf-car-hp-240 { --sf-car-hm: 240px; }
+.sf-car-hp-300 { --sf-car-hm: 300px; }
+.sf-car-hp-360 { --sf-car-hm: 360px; }
+.sf-car-hp-420 { --sf-car-hm: 420px; }
