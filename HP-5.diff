 /* ===== end of HP-4 product grid ====================================================================================================================================================== */
+
+/* ===== Carousel (shared) ============================================================================================================================================================= */
+/* HP-5: one row of items that scrolls sideways, for any page (the home page's «Карусел» today; the product page's related products later). The markup is `section.sf-car > ul.sf-car-track > li.sf-car-item` plus
+   two arrow buttons (`hidden` until storefront.js shows them: without JavaScript the row still scrolls). CSS scroll-snap, no library: the scrollbar is hidden, the finger, the trackpad, shift + wheel and the
+   keyboard (the track is focusable) scroll it, `scroll-behavior: smooth` only where the visitor accepts motion. Every choice is a class of a closed list that sets a variable (never an inline style); selectors are
+   one or two classes. A product card (`.sf-car-card`) is ONE CELL of the product grid: the same columns (4 from 64rem, 3 from 48rem, the catalog's phone columns below) and the catalog's gap (GAP-1). */
+.sf-car {
+    position: relative;
+    --sf-car-gap: 16px;
+}
+
+.sf-car-track {
+    display: flex;
+    gap: var(--sf-car-gap);
+    margin: 0;
+    padding: 0;
+    list-style: none;
+    overflow-x: auto;
+    overflow-y: hidden;
+    scroll-snap-type: x proximity;
+    scrollbar-width: none;
+    overscroll-behavior-x: contain;
+}
+
+.sf-car-track::-webkit-scrollbar {
+    display: none;
+}
+
+.sf-car-track:focus-visible {
+    outline: 2px solid var(--sf-pdp-text, #1a1a1a);
+    outline-offset: 2px;
+}
+
+@media (prefers-reduced-motion: no-preference) {
+    .sf-car-track {
+        scroll-behavior: smooth;
+    }
+}
+
+.sf-car-item {
+    flex: 0 0 auto;
+    min-width: 0;
+    scroll-snap-align: start;
+}
