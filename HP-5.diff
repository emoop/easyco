new file mode 100644
index 0000000..ae4558a
--- /dev/null
+++ b/resources/views/storefront/partials/carousel.blade.php
@@ -0,0 +1,15 @@
+{{-- HP-5, the SHARED carousel: one row of items that scrolls sideways (CSS scroll-snap; no library). The caller feeds it PREPARED items and the closed-list classes; it knows nothing of the home page (the product page's
+     related products reuse it later). Args: $class (the section's classes: `sf-car` + closed-list classes), $label (the accessible name, already plain text), $arrows (bool), $items (list of {html, class}: `html` is
+     prepared and trusted markup, `class` an optional extra class of the item). The track is a focusable `ul` (the keyboard scrolls it); the arrows are real buttons rendered `hidden`: storefront.js shows them, so without
+     JavaScript the row still scrolls. No inline style, no inline script; the same HTML for every visitor. --}}
+<section class="{{ $class }}" role="region" aria-label="{{ $label }}" data-carousel>
+    <ul class="sf-car-track" tabindex="0">
+        @foreach ($items as $entry)
+            <li class="sf-car-item {{ $entry['class'] ?? '' }}">{!! $entry['html'] !!}</li>
+        @endforeach
+    </ul>
+    @if ($arrows)
+        <button type="button" class="sf-car-arrow sf-car-prev" data-car-step="-1" aria-label="{{ __('storefront.carousel.previous') }}" hidden></button>
+        <button type="button" class="sf-car-arrow sf-car-next" data-car-step="1" aria-label="{{ __('storefront.carousel.next') }}" hidden></button>
+    @endif
+</section>
diff --git a/resources/views/storefront/partials/home/carousel.blade.php b/resources/views/storefront/partials/home/carousel.blade.php
new file mode 100644
index 0000000..e72e861
--- /dev/null
+++ b/resources/views/storefront/partials/home/carousel.blade.php
@@ -0,0 +1,23 @@
+{{-- HP-5, home section `carousel`: builds the items and hands them to the SHARED partial (storefront.partials.carousel). products = the SAME card partial as the catalog (read at request time by HomeView::fill);
+     blocks = the compiled, sanitised HTML; images / brands = our own pictures (srcset + sizes, width and height: no layout shift, lazy), a link only when set (a brand has none). Every value is escaped here; no inline
+     style, no script. $item['carousel'] = {kind, class, label, arrows, cards, blocks, pictures, sizes}. --}}
+@php
+    $c = $item['carousel'];
+    $items = [];
+
+    foreach ($c['cards'] as $n => $card) {
+        // the first two cards are loaded at once, as in the catalog's grid: the card is the SAME markup
+        $items[] = ['class' => 'sf-car-card', 'html' => view('storefront.partials.card', ['card' => $card, 'eager' => $n < 2])->render()];
+    }
+
+    foreach ($c['blocks'] as $html) {
+        $items[] = ['class' => 'sf-car-block', 'html' => $html];
+    }
+
+    foreach ($c['pictures'] as $picture) {
+        $srcset = $picture['srcset'] === [] ? '' : ' srcset="'.e(implode(', ', array_map(static fn (array $row): string => $row['url'].' '.$row['width'].'w', $picture['srcset']))).'" sizes="'.e($picture['sizes']).'"';
+        $img = '<img class="sf-car-img" src="'.e($picture['src']).'"'.$srcset.' width="'.(int) $picture['width'].'" height="'.(int) $picture['height'].'" alt="'.e($picture['alt']).'" loading="lazy" decoding="async">';
+        $items[] = ['class' => 'sf-car-picture', 'html' => $picture['url'] === null ? $img : '<a class="sf-car-link" href="'.e($picture['url']).'">'.$img.'</a>'];
+    }
+@endphp
+@include('storefront.partials.carousel', ['class' => $c['class'], 'label' => $c['label'] !== '' ? $c['label'] : __('storefront.carousel.label'), 'arrows' => $c['arrows'], 'items' => $items])
