+.sf-car-r-2-1 { --sf-car-ratio: 2 / 1; }
+.sf-car-r-3-1 { --sf-car-ratio: 3 / 1; }
+.sf-car-r-16-9 { --sf-car-ratio: 16 / 9; }
+
+.sf-car-g-0 { --sf-car-gap: 0px; }
+.sf-car-g-4 { --sf-car-gap: 4px; }
+.sf-car-g-8 { --sf-car-gap: 8px; }
