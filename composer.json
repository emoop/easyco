{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "easyco/account": "@dev",
        "easyco/address": "@dev",
        "easyco/cart": "@dev",
        "easyco/catalog": "@dev",
        "easyco/courier-boxnow": "@dev",
        "easyco/extensibility": "@dev",
        "easyco/inventory": "@dev",
        "easyco/media": "@dev",
        "easyco/operational-sales": "@dev",
        "easyco/order": "@dev",
        "easyco/payment": "@dev",
        "easyco/pricing": "@dev",
        "easyco/promotions": "@dev",
        "easyco/shipping": "@dev",
        "easyco/staff": "@dev",
        "filament/filament": "^5.0",
        "giggsey/libphonenumber-for-php-lite": "^9.0",
        "intervention/image": "^4.0",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "EasyCo\\Account\\Tests\\": "packages/EasyCo/Account/tests/",
            "EasyCo\\Address\\Tests\\": "packages/EasyCo/Address/tests/",
            "EasyCo\\Cart\\Tests\\": "packages/EasyCo/Cart/tests/",
            "EasyCo\\Catalog\\Tests\\": "packages/EasyCo/Catalog/tests/",
            "EasyCo\\CourierBoxNow\\Tests\\": "packages/EasyCo/CourierBoxNow/tests/",
            "EasyCo\\Extensibility\\Tests\\": "packages/EasyCo/Extensibility/tests/",
            "EasyCo\\Inventory\\Tests\\": "packages/EasyCo/Inventory/tests/",
            "EasyCo\\Media\\Tests\\": "packages/EasyCo/Media/tests/",
            "EasyCo\\OperationalSales\\Tests\\": "packages/EasyCo/OperationalSales/tests/",
            "EasyCo\\Order\\Tests\\": "packages/EasyCo/Order/tests/",
            "EasyCo\\Payment\\Tests\\": "packages/EasyCo/Payment/tests/",
            "EasyCo\\Pricing\\Tests\\": "packages/EasyCo/Pricing/tests/",
            "EasyCo\\Promotions\\Tests\\": "packages/EasyCo/Promotions/tests/",
            "EasyCo\\Shipping\\Tests\\": "packages/EasyCo/Shipping/tests/",
            "EasyCo\\Staff\\Tests\\": "packages/EasyCo/Staff/tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/EasyCo/*"
        }
    ]
}
