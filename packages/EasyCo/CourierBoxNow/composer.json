{
    "name": "easyco/courier-boxnow",
    "description": "EasyCo BOX NOW courier adapter (COUR-1a: the parcel-locker list only). Talks to BOX NOW only through the Shipping package's CourierHttp port.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "easyco/shipping": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "EasyCo\\CourierBoxNow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EasyCo\\CourierBoxNow\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EasyCo\\CourierBoxNow\\Providers\\CourierBoxNowServiceProvider"
            ]
        }
    }
}
