{
    "name": "easyco/account",
    "description": "EasyCo Account domain package — customer registration/login/logout/session, and the domain logic governing the accounts table.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "EasyCo\\Account\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EasyCo\\Account\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EasyCo\\Account\\Providers\\AccountServiceProvider"
            ]
        }
    }
}
