{
    "name": "easyco/courier-speedy",
    "description": "EasyCo Speedy courier adapter (COUR-1b: offices, automats and settlements only). Talks to Speedy only through the Shipping package's CourierHttp port.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "easyco/shipping": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "EasyCo\\CourierSpeedy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EasyCo\\CourierSpeedy\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EasyCo\\CourierSpeedy\\Providers\\CourierSpeedyServiceProvider"
            ]
        }
    }
}
