{
    "name": "easyco/courier-econt",
    "description": "EasyCo Econt courier adapter (COUR-1b: offices, automatic stations and settlements only). Talks to Econt only through the Shipping package's CourierHttp port.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "easyco/shipping": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "EasyCo\\CourierEcont\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EasyCo\\CourierEcont\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EasyCo\\CourierEcont\\Providers\\CourierEcontServiceProvider"
            ]
        }
    }
}
