{
    "name": "easyco/shipping",
    "description": "EasyCo Shipping domain package — ShippingClass, ShippingZone and ShippingMethod (stage 1: entities and persistence only), the foundation a carrier integration plugs into later.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "EasyCo\\Shipping\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EasyCo\\Shipping\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EasyCo\\Shipping\\Providers\\ShippingServiceProvider"
            ]
        }
    }
}
