{
    "name": "easyco/pricing",
    "description": "EasyCo Pricing domain package — currency-aware, tax-aware Price value object shared across catalog, cart, and order.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "EasyCo\\Pricing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EasyCo\\Pricing\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EasyCo\\Pricing\\Providers\\PricingServiceProvider"
            ]
        }
    }
}