{
    "name": "easyco/cart",
    "description": "EasyCo Cart domain package — Cart/CartLine, guest and logged-in shopping carts with live-resolved pricing and soft stock-aware add.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "easyco/inventory": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "EasyCo\\Cart\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EasyCo\\Cart\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EasyCo\\Cart\\Providers\\CartServiceProvider"
            ]
        }
    }
}
