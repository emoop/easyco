{
    "name": "easyco/inventory",
    "description": "EasyCo Inventory domain package — StockLevel, the domain logic governing per-Variation stock quantity.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "EasyCo\\Inventory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EasyCo\\Inventory\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EasyCo\\Inventory\\Providers\\InventoryServiceProvider"
            ]
        }
    }
}
