{
    "name": "easyco/payment",
    "description": "EasyCo Payment domain package — Payment/PaymentRefund, recording payment attempts against an order through a uniform online/offline contract, and refunds against a specific successful payment.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "easyco/pricing": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "EasyCo\\Payment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EasyCo\\Payment\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EasyCo\\Payment\\Providers\\PaymentServiceProvider"
            ]
        }
    }
}
