APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# ACC-4a: the key of the keyed hashes of the privacy log and the suppression list (64 hex characters). `easyco-install` prints one. NEVER change it after go-live; back it up with this file.
PRIVACY_HASH_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Needed for the Account domain's session-based login (Laravel Sanctum
# SPA mode) — list every hostname the storefront frontend is actually
# served from (e.g. a Laragon .test domain), comma-separated. Falls
# back to config/sanctum.php's own default (localhost/127.0.0.1 plus
# APP_URL's host) if left unset, but don't rely on the fallback for a
# real install — see account-domain-design.md §6.
# SANCTUM_STATEFUL_DOMAINS=your-app.test,localhost,127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
CART_GUEST_COOKIE_DAYS=7
# The reverse proxies (Varnish, a load balancer, a CDN) in front of the app: comma-separated IPs and CIDR ranges, e.g. 10.0.0.5,10.0.1.0/24.
# EMPTY = trust none (the client IP is the direct peer; a forged X-Forwarded-For is never recorded). NEVER a wildcard. MUST be set behind a
# proxy, or every order records the proxy address instead of the client (order-context-design.md section 7.4, production-requirements.md).
TRUSTED_PROXIES=

# P8b: the page-cache purge. null = nothing is sent (the default until the cache layer exists); P8c switches the Docker stack to varnish.
CACHE_PURGER=null
# CACHE_PURGE_URL=http://varnish   (the INTERNAL address of the cache; used only with CACHE_PURGER=varnish)

# P8d: log = every new blocking rule only LOGS what it would block (default); block = it blocks. Safe mode for recovery: set it back to log.
SECURITY_MODE=log

# DM-1: the storefront's dark mode (dark-mode.md). OFF = «Облик» has no dark-mode fields and the shop is light whatever is stored. Dev only until DM-2 is done; then the flag is removed.
STOREFRONT_DARK_MODE=false
